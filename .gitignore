# =========================================================================
# Eagles Eye — Unified Repository .gitignore
# Consolidated Single Source of Truth for DevOps & Version Control
# =========================================================================

# --- Environment variables & secrets (CRITICAL) ---
.env
.env.*
!.env.example
.flaskenv
*.env.[a-zA-Z]*
instance/
.secret
.secrets
certs/
*.pem
*.key
*.crt

# --- Python Core & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Virtual Environments ---
venv/
.venv/
ENV/
env/
venv-testing/
pythonenv*/

# --- Distribution & Builds ---
build/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Testing, Coverage, & Code Quality ---
.tox/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# --- Node & Frontend Dependencies ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- IDE & Editor Files ---
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
